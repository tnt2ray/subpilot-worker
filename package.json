{
  "name": "subpilot-worker",
  "version": "2.3.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "setup": "node scripts/setup-cloudflare.mjs",
    "update": "node scripts/update-cloudflare.mjs",
    "migrate": "node scripts/migrate-kv.mjs",
    "package:release": "node scripts/package-release.mjs",
    "types": "node scripts/generate-worker-types.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:worker": "npm run types && npm run typecheck",
    "test": "vitest run",
    "verify": "npm run typecheck:worker && npm run public:scan",
    "vendor:codemirror": "node scripts/build-codemirror-vendor.mjs",
    "public:scan": "node scripts/check-public-safety.mjs",
    "dry-run": "wrangler deploy --dry-run --outdir dist",
    "build:actions": "node scripts/build-actions-compiler.mjs",
    "prepare": "npm run build:actions"
  },
  "dependencies": {
    "@cfworker/json-schema": "4.1.1",
    "blakejs": "1.2.1",
    "mmdb-lib": "^3.0.2",
    "tweetnacl": "1.0.3",
    "yaml": "^2.8.1",
    "esbuild": "^0.28.1"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@playwright/test": "^1.61.0",
    "@types/node": "^25.9.3",
    "codemirror": "^6.0.2",
    "pkijs": "^3.4.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
